	return SampleChoiceKindCount
}
type SampleChoiceText struct {
	Text string \`json:"text"\`
}

func (SampleChoiceText) sampleChoice() {}
func (SampleChoiceText) Kind() SampleChoiceKind {
	return SampleChoiceKindText
}

type SampleChoices struct {
	Choice SampleChoice \`json:"choice"\`
	Choices []SampleChoice \`json:"choices"\`
	Mode SampleMode \`json:"mode"\`
}

type SampleChooseResult struct {
	Choice SampleChoice \`json:"choice"\`
	Choices []SampleChoice \`json:"choices"\`
	Mode SampleMode \`json:"mode"\`
}

// Kind discriminator for SampleChoice.
type SampleChoiceKind string

const (
	SampleChoiceKindCount SampleChoiceKind = "count"
	SampleChoiceKindText SampleChoiceKind = "text"
)

type SampleMode string

const (
	SampleModeFast SampleMode = "fast"
	SampleModeThorough SampleMode = "thorough"
)

type serverAPI struct {
	client *jsonrpc2.Client
}

type ServerSampleAPI serverAPI

// Choose calls sample.choose.
//
// RPC method: sample.choose.
func (a *ServerSampleAPI) Choose(ctx context.Context) (*SampleChooseResult, error) {
	raw, err := a.client.Request(ctx, "sample.choose", nil)
	if err != nil {
		return nil, err
	}
	var result SampleChooseResult
	if err := json.Unmarshal(raw, &result); err != nil {
		return nil, err
	}
	return &result, nil
}

// ServerRPC provides typed server-scoped RPC methods.
type ServerRPC struct {
	// Reuse a single struct instead of allocating one for each service on the heap.
	common serverAPI

	Sample *ServerSampleAPI
}

func NewServerRPC(client *jsonrpc2.Client) *ServerRPC {
	r := &ServerRPC{}
	r.common = serverAPI{client: client}
	r.Sample = (*ServerSampleAPI)(&r.common)
	return r
}
",
