  "rpc.rs": "//! Auto-generated typed JSON-RPC namespace — do not edit manually.
//!
//! Generated from \`api.schema.json\` by \`scripts/codegen/rust.ts\`. The
//! [\`ClientRpc\`] and [\`SessionRpc\`] view structs let callers reach every
//! protocol method through a typed namespace tree, so wire method names
//! and request/response shapes live in exactly one place — this file.

#![allow(missing_docs)]
#![allow(clippy::too_many_arguments)]
#![allow(deprecated)]
#![allow(dead_code)]

use super::api_types::{rpc_methods, *};
use crate::session::Session;
use crate::{Client, Error};

/// Typed view over the [\`Client\`]'s server-level RPC namespace.
#[derive(Clone, Copy)]
pub struct ClientRpc<'a> {
    pub(crate) client: &'a Client,
}

impl<'a> ClientRpc<'a> {
    /// \`sample.*\` sub-namespace.
    pub fn sample(&self) -> ClientRpcSample<'a> {
        ClientRpcSample { client: self.client }
    }

}

/// \`sample.*\` RPCs.
#[derive(Clone, Copy)]
pub struct ClientRpcSample<'a> {
    pub(crate) client: &'a Client,
}

impl<'a> ClientRpcSample<'a> {
    /// \`sample.nested.*\` sub-namespace.
    pub fn nested(&self) -> ClientRpcSampleNested<'a> {
        ClientRpcSampleNested { client: self.client }
    }

    /// Look up an item.
    ///
    /// Wire method: \`sample.get\`.
    ///
    /// # Returns
    ///
    /// An item returned by the sample service.
    pub async fn get(&self, params: SampleGetRequest) -> Result<SampleItem, Error> {
        let wire_params = serde_json::to_value(params)?;
        let _value = self.client.call(rpc_methods::SAMPLE_GET, Some(wire_params)).await?;
        Ok(serde_json::from_value(_value)?)
    }

    /// Calls \`sample.ping\`.
    ///
    /// Wire method: \`sample.ping\`.
    pub async fn ping(&self) -> Result<(), Error> {
        let wire_params = serde_json::json!({});
        let _value = self.client.call(rpc_methods::SAMPLE_PING, Some(wire_params)).await?;
        Ok(())
    }

}

/// \`sample.nested.*\` RPCs.
#[derive(Clone, Copy)]
pub struct ClientRpcSampleNested<'a> {
    pub(crate) client: &'a Client,
}

impl<'a> ClientRpcSampleNested<'a> {
    /// Calls \`sample.nested.list\`.
    ///
    /// Wire method: \`sample.nested.list\`.
    pub async fn list(&self) -> Result<SampleListResult, Error> {
        let wire_params = serde_json::json!({});
        let _value = self.client.call(rpc_methods::SAMPLE_NESTED_LIST, Some(wire_params)).await?;
        Ok(serde_json::from_value(_value)?)
    }

}

/// Typed view over a [\`Session\`]'s RPC namespace.
#[derive(Clone, Copy)]
pub struct SessionRpc<'a> {
    pub(crate) session: &'a Session,
}

impl<'a> SessionRpc<'a> {
    /// \`session.sample.*\` sub-namespace.
    pub fn sample(&self) -> SessionRpcSample<'a> {
        SessionRpcSample { session: self.session }
    }

}

/// \`session.sample.*\` RPCs.
#[derive(Clone, Copy)]
pub struct SessionRpcSample<'a> {
    pub(crate) session: &'a Session,
}

impl<'a> SessionRpcSample<'a> {
    /// Calls \`session.sample.get\`.
    ///
    /// Wire method: \`session.sample.get\`.
    ///
    /// # Returns
    ///
    /// An item returned by the sample service.
    pub async fn get(&self, params: SessionSampleGetRequest) -> Result<SampleItem, Error> {
        let mut wire_params = serde_json::to_value(params)?;
        wire_params["sessionId"] = serde_json::Value::String(self.session.id().to_string());
        let _value = self.session.client().call(rpc_methods::SESSION_SAMPLE_GET, Some(wire_params)).await?;
        Ok(serde_json::from_value(_value)?)
    }

}
",
